@pytest.fixture(scope="session", autouse=True)
def setup_test_database() -> Generator[None, None, None]:
    """Aplica las migraciones de Alembic a la BD de test.

    Como Alembic corre como secureaudit_system (owner del schema),
    las tablas se crean con el owner correcto desde el inicio.
    """

    # 1. Limpiar tablas/funciones del schema public (sin dropearlo)
    system_engine = create_engine(settings.SYSTEM_DATABASE_URL)
    with system_engine.connect() as conn:
        conn.execute(text("""
            DO $$
            DECLARE r RECORD;
            BEGIN
                FOR r IN SELECT tablename FROM pg_tables WHERE schemaname = 'public'
                LOOP
                    EXECUTE 'DROP TABLE IF EXISTS public.' || quote_ident(r.tablename) || ' CASCADE';
                END LOOP;
                FOR r IN SELECT sequence_name FROM information_schema.sequences WHERE sequence_schema = 'public'
                LOOP
                    EXECUTE 'DROP SEQUENCE IF EXISTS public.' || quote_ident(r.sequence_name) || ' CASCADE';
                END LOOP;
                FOR r IN SELECT routine_name FROM information_schema.routines WHERE routine_schema = 'public' AND routine_type = 'FUNCTION'
                LOOP
                    EXECUTE 'DROP FUNCTION IF EXISTS public.' || quote_ident(r.routine_name) || ' CASCADE';
                END LOOP;
            END $$;
        """))
        conn.commit()
    system_engine.dispose()

    # 2. Aplicar migraciones de Alembic
    env = {
        **os.environ,
        "DATABASE_URL": settings.DATABASE_URL,
        "SYSTEM_DATABASE_URL": settings.SYSTEM_DATABASE_URL,
    }

    # Alembic usa SYSTEM_DATABASE_URL para las migraciones (owner correcto)
    result = subprocess.run(
        ["alembic", "-x", f"db_url={settings.SYSTEM_DATABASE_URL}", "upgrade", "head"],
        capture_output=True,
        text=True,
        env={
            **env,
            "ALEMBIC_DATABASE_URL": settings.SYSTEM_DATABASE_URL,
        },
        cwd=os.path.dirname(os.path.dirname(os.path.abspath(__file__))),
    )
    if result.returncode != 0:
        print("STDOUT:", result.stdout)
        print("STDERR:", result.stderr)
        raise RuntimeError("Alembic upgrade falló")

    # 3. Dar permisos al rol de app (secureaudit)
    system_engine = create_engine(settings.SYSTEM_DATABASE_URL)
    with system_engine.connect() as conn:
        conn.execute(text("GRANT ALL ON ALL TABLES IN SCHEMA public TO secureaudit"))
        conn.execute(text("GRANT ALL ON ALL SEQUENCES IN SCHEMA public TO secureaudit"))
        conn.execute(text("GRANT ALL ON ALL FUNCTIONS IN SCHEMA public TO secureaudit"))
        conn.commit()
    system_engine.dispose()

    yield

    # Teardown (no dropear el schema, solo las tablas)
    system_engine = create_engine(settings.SYSTEM_DATABASE_URL)
    with system_engine.connect() as conn:
        conn.execute(text("""
            DO $$
            DECLARE r RECORD;
            BEGIN
                FOR r IN SELECT tablename FROM pg_tables WHERE schemaname = 'public'
                LOOP
                    EXECUTE 'DROP TABLE IF EXISTS public.' || quote_ident(r.tablename) || ' CASCADE';
                END LOOP;
            END $$;
        """))
        conn.commit()
    system_engine.dispose()


